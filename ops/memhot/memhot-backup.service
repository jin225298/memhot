[Unit]
Description=Private online SQLite backup for Memhot
After=memhot.service

[Service]
Type=oneshot
User=memhot
Group=memhot
Environment=MEMHOT_DATA_DIR=/var/lib/memhot
ExecStart=/usr/bin/python3 /opt/memhot/backup.py
UMask=0077
MemoryMax=128M
CPUQuota=25%
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/memhot
