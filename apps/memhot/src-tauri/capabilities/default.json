{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Trusted bundled Memhot UI only; no remote domains receive native access.",
  "windows": ["main"],
  "permissions": ["core:default", "memhot-capture:default", "memhot-updater:default", {
    "identifier": "opener:allow-open-url",
    "allow": [{ "url": "https://*" }, { "url": "http://*" }]
  }]
}
